<?xml version="1.0" encoding="UTF-8"?>
<project name="WareStat" default="build" basedir=".">
    <description>
        WareStat - Business Management Software
        Automated build for JAR and native executable creation
    </description>

    <!-- Load build properties -->
    <property file="build.properties"/>

    <!-- Default properties (can be overridden in build.properties) -->
    <property name="app.name" value="WareStat"/>
    <property name="app.version" value="1.3"/>
    <property name="app.vendor" value="WareStat"/>
    <property name="main.class" value="MainWindow"/>
    <property name="app.identifier" value="com.warestat.app"/>
    <property name="windows.upgrade.uuid" value="ee55bd31-e9b9-5503-bca5-9ac13d0501b1"/>

    <!-- Directory structure -->
    <property name="src.dir" location="src"/>
    <property name="lib.dir" location="lib"/>
    <property name="build.dir" location="build"/>
    <property name="build.classes.dir" location="${build.dir}/classes"/>
    <property name="dist.dir" location="dist"/>
    <property name="tools.dir" location="tools"/>
    <property name="resources.dir" location="resources"/>
    <property name="icons.dir" location="${resources.dir}/icons"/>
    <property name="custom.runtime.dir" location="${build.dir}/custom-runtime"/>
    <property name="release.build.dir" location="${build.dir}/release"/>
    <property name="release.classes.dir" location="${release.build.dir}/classes"/>
    <property name="private.build.dir" location="${build.dir}/private"/>
    <property name="proguard.version" value="7.10.0"/>
    <property name="proguard.sha256" value="5aa88c434766a057a2ead3412acc01022bb444f9f1bfbae690a1d48b2006b242"/>
    <property name="proguard.zip" location="${tools.dir}/proguard-${proguard.version}.zip"/>
    <property name="proguard.home" location="${tools.dir}/proguard-${proguard.version}"/>
    <property name="proguard.jar" location="${proguard.home}/lib/proguard.jar"/>

    <!-- Icon files for different platforms -->
    <property name="icon.windows" location="${icons.dir}/warestat.ico"/>
    <property name="icon.mac" location="${icons.dir}/warestat.icns"/>
    <property name="icon.linux" location="${icons.dir}/warestat.png"/>

    <!-- Output files -->
    <property name="jar.file" value="${dist.dir}/${app.name}-${app.version}.jar"/>
    <property name="jar.release.input.file" value="${release.build.dir}/${app.name}-${app.version}-input.jar"/>
    <property name="jar.obfuscated.file" value="${release.build.dir}/${app.name}-${app.version}-protected.jar"/>
    <property name="jar.platform.file" value="${release.build.dir}/${app.name}-${app.version}-runtime.jar"/>
    <property name="jar.license.file" value="${dist.dir}/License-Viewer.jar"/>
    <property name="proguard.mapping.file" value="${private.build.dir}/proguard-mapping-${app.version}.txt"/>
    <property name="proguard.usage.file" value="${private.build.dir}/proguard-usage-${app.version}.txt"/>
    <property name="proguard.seeds.file" value="${private.build.dir}/proguard-seeds-${app.version}.txt"/>
    <property name="proguard.config.file" value="${private.build.dir}/proguard-config-${app.version}.txt"/>

    <!-- Classpath for compilation -->
    <path id="compile.classpath">
        <fileset dir="${lib.dir}">
            <include name="**/*.jar"/>
        </fileset>
    </path>

    <!-- =================================
          Target: init
         ================================= -->
    <target name="init">
        <echo message="Building ${app.name} v${app.version}"/>
        <available file="${lib.dir}/webview-1.0.10.jar" property="webview.jar.available"/>
        <fail unless="webview.jar.available"
              message="Missing lib/webview-1.0.10.jar; Discover requires WebViewComponent."/>
        <available file="${resources.dir}/fonts/DejaVuSans.ttf" property="pdf.font.regular.available"/>
        <available file="${resources.dir}/fonts/DejaVuSans-Bold.ttf" property="pdf.font.bold.available"/>
        <available file="${resources.dir}/fonts/LICENSE-DejaVu.txt" property="pdf.font.license.available"/>
        <fail unless="pdf.font.regular.available" message="Missing resources/fonts/DejaVuSans.ttf. Update the complete project before building."/>
        <fail unless="pdf.font.bold.available" message="Missing resources/fonts/DejaVuSans-Bold.ttf. Update the complete project before building."/>
        <fail unless="pdf.font.license.available" message="Missing resources/fonts/LICENSE-DejaVu.txt. Restore the font license before building."/>
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${build.classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
        <mkdir dir="${tools.dir}"/>
    </target>

    <!-- =================================
          Target: clean
         ================================= -->
    <target name="clean" description="Clean build artifacts">
        <echo message="Cleaning build directories..."/>
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <!-- =================================
          Target: compile
         ================================= -->
    <target name="compile" depends="init" description="Compile Java sources">
        <echo message="Compiling Java sources..."/>
        <javac srcdir="${src.dir}"
               destdir="${build.classes.dir}"
               includeantruntime="false"
               debug="true"
               encoding="UTF-8"
               source="21"
               target="21">
            <classpath refid="compile.classpath"/>
        </javac>
        <!-- Keep runtime resources available when running directly from build/classes. -->
        <copy todir="${build.classes.dir}">
            <fileset dir="${resources.dir}">
                <include name="i18n/**"/>
                <include name="icons/**"/>
                <include name="fonts/**"/>
            </fileset>

            <!-- Legal notices must remain readable in every distribution. -->
            <fileset dir=".">
                <include name="LICENSE-THIRD-PARTY.txt"/>
                <include name="NOTICE.txt"/>
            </fileset>
        </copy>
        <echo message="Compilation complete!"/>
    </target>

    <!-- =================================
          Target: jar
         ================================= -->
    <target name="jar" depends="compile" description="Create executable JAR with dependencies">
        <echo message="Creating executable JAR..."/>

        <!-- Create temporary directory for unpacking libraries -->
        <mkdir dir="${build.dir}/jar-temp"/>

        <!-- Unpack all dependency JARs -->
        <unzip dest="${build.dir}/jar-temp">
            <fileset dir="${lib.dir}">
                <include name="**/*.jar"/>
                <exclude name="webview-1.0.10.jar"/>
            </fileset>
        </unzip>

        <!-- Create the JAR with all classes -->
        <jar destfile="${jar.file}" filesetmanifest="mergewithoutmain">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
                <attribute name="Implementation-Title" value="${app.name}"/>
                <attribute name="Implementation-Version" value="${app.version}"/>
                <attribute name="Implementation-Vendor" value="${app.vendor}"/>
                <attribute name="Built-By" value="${user.name}"/>
                <attribute name="Built-Date" value="${TODAY}"/>
                <attribute name="Class-Path" value="webview-1.0.10.jar"/>
            </manifest>

            <!-- Add compiled classes -->
            <fileset dir="${build.classes.dir}"/>

            <!-- Add unpacked dependencies -->
            <fileset dir="${build.dir}/jar-temp">
                <!-- Exclude signature files to avoid security exceptions -->
                <exclude name="META-INF/*.SF"/>
                <exclude name="META-INF/*.DSA"/>
                <exclude name="META-INF/*.RSA"/>
            </fileset>
        </jar>
        <copy file="${lib.dir}/webview-1.0.10.jar" todir="${dist.dir}"/>

        <resourcecount property="runtime.jar.font.count">
            <zipfileset src="${jar.file}" includes="fonts/DejaVuSans.ttf,fonts/DejaVuSans-Bold.ttf,fonts/LICENSE-DejaVu.txt"/>
        </resourcecount>
        <fail message="Invalid application JAR: PDF fonts or their license are missing.">
            <condition><not><equals arg1="${runtime.jar.font.count}" arg2="3"/></not></condition>
        </fail>
        <copy file="LICENSE-THIRD-PARTY.txt" todir="${dist.dir}"/>
        <copy file="NOTICE.txt" todir="${dist.dir}"/>

        <!-- Clean up temporary directory -->
        <delete dir="${build.dir}/jar-temp"/>

        <echo message="JAR created: ${jar.file}"/>
    </target>

    <target name="verify-runtime-jar" depends="jar"
            description="Verify that required application classes are packaged">
        <available classname="AboutDialog" ignoresystemclasses="true"
                   property="runtime.jar.about.available">
            <classpath>
                <pathelement location="${jar.file}"/>
            </classpath>
        </available>
        <fail unless="runtime.jar.about.available"
              message="Invalid application JAR: AboutDialog.class is missing."/>
    </target>

    <!-- =================================
          Target: compile-release
         ================================= -->
    <target name="compile-release" depends="init" description="Compile production classes without local debug metadata">
        <echo message="Compiling production classes..."/>
        <mkdir dir="${release.classes.dir}"/>
        <javac srcdir="${src.dir}"
               destdir="${release.classes.dir}"
               includeantruntime="false"
               debug="false"
               encoding="UTF-8"
               source="21"
               target="21">
            <classpath refid="compile.classpath"/>
        </javac>
        <copy todir="${release.classes.dir}">
            <fileset dir="${resources.dir}">
                <include name="i18n/**"/>
                <include name="icons/**"/>
                <include name="fonts/**"/>
            </fileset>
            <fileset dir=".">
                <include name="LICENSE-THIRD-PARTY.txt"/>
                <include name="NOTICE.txt"/>
            </fileset>
        </copy>
        <echo message="Production compilation complete."/>
    </target>

    <!-- =================================
          Target: jar-release-input
         ================================= -->
    <target name="jar-release-input" depends="compile-release"
            description="Create a clean production input JAR for ProGuard">
        <delete dir="${release.build.dir}/jar-temp"/>
        <mkdir dir="${release.build.dir}/jar-temp"/>

        <unzip dest="${release.build.dir}/jar-temp">
            <fileset dir="${lib.dir}">
                <include name="**/*.jar"/>
                <exclude name="webview-1.0.10.jar"/>
            </fileset>
        </unzip>

        <jar destfile="${jar.release.input.file}" filesetmanifest="mergewithoutmain">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
                <attribute name="Implementation-Title" value="${app.name}"/>
                <attribute name="Implementation-Version" value="${app.version}"/>
                <attribute name="Implementation-Vendor" value="${app.vendor}"/>
                <attribute name="Class-Path" value="webview-1.0.10.jar"/>
            </manifest>
            <fileset dir="${release.classes.dir}"/>
            <fileset dir="${release.build.dir}/jar-temp">
                <exclude name="META-INF/*.SF"/>
                <exclude name="META-INF/*.DSA"/>
                <exclude name="META-INF/*.RSA"/>
            </fileset>
        </jar>

        <delete dir="${release.build.dir}/jar-temp"/>
        <echo message="Production input JAR created: ${jar.release.input.file}"/>
    </target>

    <!-- =================================
          Target: download-proguard
         ================================= -->
    <target name="download-proguard" depends="init" description="Download and verify ProGuard">
        <get src="https://github.com/Guardsquare/proguard/releases/download/v${proguard.version}/proguard-${proguard.version}.zip"
             dest="${proguard.zip}"
             skipexisting="true"
             verbose="true"/>

        <checksum file="${proguard.zip}" algorithm="SHA-256" property="proguard.actual.sha256"/>
        <fail message="ProGuard archive checksum mismatch. Delete ${proguard.zip} and rebuild.">
            <condition>
                <not>
                    <equals arg1="${proguard.actual.sha256}" arg2="${proguard.sha256}"/>
                </not>
            </condition>
        </fail>

        <unzip src="${proguard.zip}" dest="${tools.dir}" overwrite="false"/>
        <available file="${proguard.jar}" property="proguard.available"/>
        <fail unless="proguard.available"
              message="Verified ProGuard archive does not contain the expected lib/proguard.jar."/>
    </target>

    <!-- =================================
          Target: obfuscate
         ================================= -->
    <target name="obfuscate" depends="jar-release-input,download-proguard"
            description="Shrink, optimize and obfuscate the production JAR with ProGuard">
        <echo message="Protecting production JAR with ProGuard ${proguard.version}..."/>
        <mkdir dir="${private.build.dir}"/>
        <delete file="${jar.obfuscated.file}"/>

        <java jar="${proguard.jar}" fork="true" failonerror="true" maxmemory="2048m">
            <arg value="@proguard.pro"/>
            <arg value="-injars"/>
            <arg value="${jar.release.input.file}"/>
            <arg value="-outjars"/>
            <arg value="${jar.obfuscated.file}"/>
            <arg value="-printmapping"/>
            <arg value="${proguard.mapping.file}"/>
            <arg value="-printusage"/>
            <arg value="${proguard.usage.file}"/>
            <arg value="-printseeds"/>
            <arg value="${proguard.seeds.file}"/>
            <arg value="-printconfiguration"/>
            <arg value="${proguard.config.file}"/>
        </java>

        <echo message="Protected JAR created: ${jar.obfuscated.file}"/>
        <echo message="Private mapping: ${proguard.mapping.file}"/>
    </target>

    <!-- =================================
          Target: verify-protected-jar
         ================================= -->
    <target name="verify-protected-jar" depends="obfuscate"
            description="Verify required entry points and resources in the protected JAR">
        <available classname="${main.class}" ignoresystemclasses="true"
                   property="runtime.protected.main.available">
            <classpath>
                <pathelement location="${jar.obfuscated.file}"/>
            </classpath>
        </available>
        <fail unless="runtime.protected.main.available"
              message="Invalid protected JAR: main class is missing."/>

        <available classname="AboutDialog" ignoresystemclasses="true"
                   property="runtime.protected.about.available">
            <classpath>
                <pathelement location="${jar.obfuscated.file}"/>
            </classpath>
        </available>
        <fail unless="runtime.protected.about.available"
              message="Invalid protected JAR: AboutDialog stable entry is missing."/>

        <resourcecount property="runtime.protected.jar.font.count">
            <zipfileset src="${jar.obfuscated.file}"
                        includes="fonts/DejaVuSans.ttf,fonts/DejaVuSans-Bold.ttf,fonts/LICENSE-DejaVu.txt"/>
        </resourcecount>
        <fail message="Invalid protected JAR: PDF fonts or their license are missing.">
            <condition>
                <not><equals arg1="${runtime.protected.jar.font.count}" arg2="3"/></not>
            </condition>
        </fail>

        <resourcecount property="runtime.protected.jar.sqlite.driver.count">
            <zipfileset src="${jar.obfuscated.file}" includes="org/sqlite/JDBC.class"/>
        </resourcecount>
        <fail message="Invalid protected JAR: SQLite JDBC entry point is missing.">
            <condition>
                <not><equals arg1="${runtime.protected.jar.sqlite.driver.count}" arg2="1"/></not>
            </condition>
        </fail>
    </target>

    <!-- =================================
          Target: strip-platform-natives
         ================================= -->
    <target name="strip-platform-natives" depends="verify-protected-jar"
            description="Remove SQLite native binaries for platforms other than the current release target">
        <condition property="sqlite.native.keep" value="org/sqlite/native/Windows/x86_64/**">
            <and>
                <os family="windows"/>
                <or><os arch="amd64"/><os arch="x86_64"/></or>
            </and>
        </condition>
        <condition property="sqlite.native.expected"
                   value="${release.build.dir}/platform-jar/org/sqlite/native/Windows/x86_64/sqlitejdbc.dll">
            <and>
                <os family="windows"/>
                <or><os arch="amd64"/><os arch="x86_64"/></or>
            </and>
        </condition>

        <condition property="sqlite.native.keep" value="org/sqlite/native/Mac/aarch64/**">
            <and><os family="mac"/><os arch="aarch64"/></and>
        </condition>
        <condition property="sqlite.native.expected"
                   value="${release.build.dir}/platform-jar/org/sqlite/native/Mac/aarch64/libsqlitejdbc.dylib">
            <and><os family="mac"/><os arch="aarch64"/></and>
        </condition>

        <condition property="sqlite.native.keep" value="org/sqlite/native/Mac/x86_64/**">
            <and>
                <os family="mac"/>
                <or><os arch="x86_64"/><os arch="amd64"/></or>
            </and>
        </condition>
        <condition property="sqlite.native.expected"
                   value="${release.build.dir}/platform-jar/org/sqlite/native/Mac/x86_64/libsqlitejdbc.dylib">
            <and>
                <os family="mac"/>
                <or><os arch="x86_64"/><os arch="amd64"/></or>
            </and>
        </condition>

        <fail unless="sqlite.native.keep"
              message="Unsupported release architecture for SQLite native pruning: ${os.name} / ${os.arch}"/>

        <delete dir="${release.build.dir}/platform-jar"/>
        <mkdir dir="${release.build.dir}/platform-jar"/>
        <unzip src="${jar.obfuscated.file}" dest="${release.build.dir}/platform-jar"/>

        <delete>
            <fileset dir="${release.build.dir}/platform-jar">
                <include name="org/sqlite/native/**"/>
                <exclude name="${sqlite.native.keep}"/>
            </fileset>
        </delete>

        <available file="${sqlite.native.expected}" property="sqlite.native.expected.available"/>
        <fail unless="sqlite.native.expected.available"
              message="The protected JAR does not contain the SQLite native binary expected for this platform."/>

        <delete file="${jar.platform.file}"/>
        <zip destfile="${jar.platform.file}" basedir="${release.build.dir}/platform-jar" level="9"/>
        <delete dir="${release.build.dir}/platform-jar"/>

        <echo message="Platform-specific runtime JAR created: ${jar.platform.file}"/>
    </target>

    <!-- =================================
          Target: compile-license-viewer
         ================================= -->
    <target name="compile-license-viewer" depends="init" description="Compile license viewer sources">
        <echo message="Compiling license viewer..."/>
        <mkdir dir="${build.dir}/license-classes"/>
        <javac srcdir="${src.dir}"
               destdir="${build.dir}/license-classes"
               includeantruntime="false"
               debug="false"
               source="21"
               target="21"
               includes="LicenseText.java,AppConstants.java">
            <classpath refid="compile.classpath"/>
        </javac>
        <echo message="License viewer compilation complete!"/>
    </target>

    <!-- =================================
          Target: jar-license
         ================================= -->
    <target name="jar-license" depends="compile-license-viewer" description="Create executable JAR for license viewer">
        <echo message="Creating license viewer JAR..."/>

        <jar destfile="${jar.license.file}" filesetmanifest="mergewithoutmain">
            <manifest>
                <attribute name="Main-Class" value="LicenseText"/>
                <attribute name="Implementation-Title" value="${app.name} License Viewer"/>
                <attribute name="Implementation-Version" value="${app.version}"/>
                <attribute name="Implementation-Vendor" value="${app.vendor}"/>
            </manifest>

            <!-- Add compiled classes -->
            <fileset dir="${build.dir}/license-classes"/>
        </jar>

        <echo message="License viewer JAR created: ${jar.license.file}"/>
    </target>

    <!-- =================================
          Target: create-custom-runtime
         ================================= -->
    <target name="create-custom-runtime" description="Create custom JRE with jlink for smaller distribution">
        <echo message="Creating custom JRE with jlink..."/>
        <echo message="This will reduce the runtime size from ~200MB to ~50MB"/>

        <!-- Delete existing custom runtime if present -->
        <delete dir="${custom.runtime.dir}"/>

        <!-- Create custom runtime with the modules used by the Swing application. -->
        <exec executable="jlink" failonerror="true">
            <arg value="--add-modules"/>
            <arg value="java.base,java.desktop,java.sql,java.logging,java.naming,java.management,java.net.http,jdk.crypto.ec,jdk.unsupported"/>
            <arg value="--strip-debug"/>
            <arg value="--strip-native-commands"/>
            <arg value="--no-header-files"/>
            <arg value="--no-man-pages"/>
            <arg value="--compress=2"/>
            <arg value="--output"/>
            <arg value="${custom.runtime.dir}"/>
        </exec>

        <echo message="Custom JRE created successfully at: ${custom.runtime.dir}"/>

        <!-- Display size comparison -->
        <exec executable="du" osfamily="unix" outputproperty="runtime.size">
            <arg value="-sh"/>
            <arg value="${custom.runtime.dir}"/>
        </exec>
        <echo message="Custom runtime size: ${runtime.size}"/>
    </target>

    <!-- =================================
          Target: jpackage-check
         ================================= -->
    <target name="jpackage-check">
        <exec executable="jpackage" failifexecutionfails="false" resultproperty="jpackage.present">
            <arg value="--version"/>
        </exec>
        <condition property="jpackage.available">
            <equals arg1="${jpackage.present}" arg2="0"/>
        </condition>
    </target>

    <!-- =================================
          Target: package-exe (Development - No obfuscation)
         ================================= -->
    <target name="package-exe" depends="verify-runtime-jar,create-custom-runtime,jpackage-check"
            description="Create native executable (development build, no obfuscation)">
        <fail unless="jpackage.available"
              message="jpackage not found! Please ensure you have JDK 14+ with jpackage in your PATH."/>

        <echo message="Creating native executable from JAR (development build)..."/>
        <echo message="Using custom JRE to reduce size by ~60%"/>
        <echo message="This may take several minutes..."/>

        <!-- Create clean input directory for jpackage -->
        <mkdir dir="${build.dir}/jpackage-input-dev"/>
        <copy file="${jar.file}" todir="${build.dir}/jpackage-input-dev"/>
        <copy file="${lib.dir}/webview-1.0.10.jar" todir="${build.dir}/jpackage-input-dev"/>

        <!-- Detect OS and set icon file accordingly -->
        <condition property="is.windows">
            <os family="windows"/>
        </condition>
        <condition property="is.mac">
            <os family="mac"/>
        </condition>
        <condition property="is.linux">
            <and>
                <os family="unix"/>
                <not><os family="mac"/></not>
            </and>
        </condition>

        <!-- Determine which icon file to use based on OS -->
        <condition property="icon.file" value="${icon.windows}">
            <isset property="is.windows"/>
        </condition>
        <condition property="icon.file" value="${icon.mac}">
            <isset property="is.mac"/>
        </condition>
        <condition property="icon.file" value="${icon.linux}">
            <isset property="is.linux"/>
        </condition>

        <!-- Check if icon file exists -->
        <available file="${icon.file}" property="icon.exists"/>
        <condition property="use.icon">
            <and>
                <isset property="icon.file"/>
                <isset property="icon.exists"/>
            </and>
        </condition>

        <!-- Display icon status -->
        <echo message="Platform: ${os.name}"/>
        <echo message="Icon file: ${icon.file}"/>
        <condition property="icon.status" value="found - will be included" else="not found - using default">
            <isset property="use.icon"/>
        </condition>
        <echo message="Icon status: ${icon.status}"/>

        <!-- Common jpackage arguments with custom runtime -->
        <!-- Execute with icon if available -->
        <exec executable="jpackage" failonerror="true" if:set="use.icon"
              xmlns:if="ant:if">
            <arg value="--input"/><arg value="${build.dir}/jpackage-input-dev"/>
            <arg value="--name"/><arg value="${app.name}-dev"/>
            <arg value="--main-jar"/><arg value="${app.name}-${app.version}.jar"/>
            <arg value="--main-class"/><arg value="${main.class}"/>
            <arg value="--type"/><arg value="app-image"/>
            <arg value="--dest"/><arg value="${dist.dir}"/>
            <arg value="--app-version"/><arg value="${app.version}"/>
            <arg value="--vendor"/><arg value="${app.vendor}"/>
            <arg value="--description"/><arg value="Business Management Software (Development Build)"/>
            <arg value="--runtime-image"/><arg value="${custom.runtime.dir}"/>
            <arg value="--java-options"/><arg value="-Xmx1024m"/>
            <arg value="--icon"/>
            <arg value="${icon.file}"/>
        </exec>

        <!-- Execute without icon if not available -->
        <exec executable="jpackage" failonerror="true" unless:set="use.icon"
              xmlns:unless="ant:unless">
            <arg value="--input"/><arg value="${build.dir}/jpackage-input-dev"/>
            <arg value="--name"/><arg value="${app.name}-dev"/>
            <arg value="--main-jar"/><arg value="${app.name}-${app.version}.jar"/>
            <arg value="--main-class"/><arg value="${main.class}"/>
            <arg value="--type"/><arg value="app-image"/>
            <arg value="--dest"/><arg value="${dist.dir}"/>
            <arg value="--app-version"/><arg value="${app.version}"/>
            <arg value="--vendor"/><arg value="${app.vendor}"/>
            <arg value="--description"/><arg value="Business Management Software (Development Build)"/>
            <arg value="--runtime-image"/><arg value="${custom.runtime.dir}"/>
            <arg value="--java-options"/><arg value="-Xmx1024m"/>
        </exec>

        <!-- Clean up temporary input directory -->
        <delete dir="${build.dir}/jpackage-input-dev"/>

        <echo message="Native executable created in: ${dist.dir}/${app.name}-dev/"/>
        <echo message="Using optimized custom JRE"/>
    </target>

    <!-- =================================
          Target: package-exe-release (Production - Protected)
         ================================= -->
    <target name="package-exe-release" depends="strip-platform-natives,create-custom-runtime,jpackage-check"
            description="Create native executable (production build, protected, with custom JRE)">
        <fail unless="jpackage.available"
              message="jpackage not found! Please ensure you have JDK 14+ with jpackage in your PATH."/>

        <echo message="Creating native executable from protected JAR (production build)..."/>
        <echo message="Using custom JRE to reduce size by ~60%"/>
        <echo message="This may take several minutes..."/>

        <!-- Create clean input directory for jpackage -->
        <mkdir dir="${build.dir}/jpackage-input-release"/>
        <copy file="${jar.platform.file}" todir="${build.dir}/jpackage-input-release"/>
        <copy file="${lib.dir}/webview-1.0.10.jar" todir="${build.dir}/jpackage-input-release"/>
        <copy file="LICENSE-THIRD-PARTY.txt" todir="${build.dir}/jpackage-input-release"/>
        <copy file="NOTICE.txt" todir="${build.dir}/jpackage-input-release"/>

        <!-- Detect OS and set icon file accordingly (same as dev build) -->
        <condition property="is.windows.release">
            <os family="windows"/>
        </condition>
        <condition property="is.mac.release">
            <os family="mac"/>
        </condition>
        <condition property="is.linux.release">
            <and>
                <os family="unix"/>
                <not><os family="mac"/></not>
            </and>
        </condition>

        <!-- Stable macOS bundle identity; empty on other platforms. -->
        <condition property="release.platform.jpackage.args"
                   value="--mac-package-identifier ${app.identifier} --mac-package-name ${app.name}"
                   else="">
            <isset property="is.mac.release"/>
        </condition>

        <!-- Determine which icon file to use based on OS -->
        <condition property="icon.file.release" value="${icon.windows}">
            <isset property="is.windows.release"/>
        </condition>
        <condition property="icon.file.release" value="${icon.mac}">
            <isset property="is.mac.release"/>
        </condition>
        <condition property="icon.file.release" value="${icon.linux}">
            <isset property="is.linux.release"/>
        </condition>

        <!-- Check if icon file exists -->
        <available file="${icon.file.release}" property="icon.exists.release"/>
        <condition property="use.icon.release">
            <and>
                <isset property="icon.file.release"/>
                <isset property="icon.exists.release"/>
            </and>
        </condition>

        <!-- Display icon status -->
        <echo message="Platform: ${os.name}"/>
        <echo message="Icon file: ${icon.file.release}"/>
        <condition property="icon.status.release" value="found - will be included" else="not found - using default">
            <isset property="use.icon.release"/>
        </condition>
        <echo message="Icon status: ${icon.status.release}"/>

        <!-- Common jpackage arguments with custom runtime -->
        <!-- Execute with icon if available -->
        <exec executable="jpackage" failonerror="true" if:set="use.icon.release"
              xmlns:if="ant:if">
            <arg value="--input"/><arg value="${build.dir}/jpackage-input-release"/>
            <arg value="--name"/><arg value="${app.name}"/>
            <arg value="--main-jar"/><arg value="${app.name}-${app.version}-runtime.jar"/>
            <arg value="--main-class"/><arg value="${main.class}"/>
            <arg value="--type"/><arg value="app-image"/>
            <arg value="--dest"/><arg value="${dist.dir}"/>
            <arg value="--app-version"/><arg value="${app.version}"/>
            <arg value="--vendor"/><arg value="${app.vendor}"/>
            <arg value="--description"/><arg value="Business Management Software (Production Build)"/>
            <arg value="--runtime-image"/><arg value="${custom.runtime.dir}"/>
            <arg value="--java-options"/><arg value="-Xmx1024m"/>
            <arg line="${release.platform.jpackage.args}"/>
            <arg value="--icon"/>
            <arg value="${icon.file.release}"/>
        </exec>

        <!-- Execute without icon if not available -->
        <exec executable="jpackage" failonerror="true" unless:set="use.icon.release"
              xmlns:unless="ant:unless">
            <arg value="--input"/><arg value="${build.dir}/jpackage-input-release"/>
            <arg value="--name"/><arg value="${app.name}"/>
            <arg value="--main-jar"/><arg value="${app.name}-${app.version}-runtime.jar"/>
            <arg value="--main-class"/><arg value="${main.class}"/>
            <arg value="--type"/><arg value="app-image"/>
            <arg value="--dest"/><arg value="${dist.dir}"/>
            <arg value="--app-version"/><arg value="${app.version}"/>
            <arg value="--vendor"/><arg value="${app.vendor}"/>
            <arg value="--description"/><arg value="Business Management Software (Production Build)"/>
            <arg value="--runtime-image"/><arg value="${custom.runtime.dir}"/>
            <arg value="--java-options"/><arg value="-Xmx1024m"/>
            <arg line="${release.platform.jpackage.args}"/>
        </exec>

        <!-- Clean up temporary input directory -->
        <delete dir="${build.dir}/jpackage-input-release"/>

        <echo message="Native executable (protected, optimized) created in: ${dist.dir}/${app.name}/"/>
        <echo message="This build uses a custom JRE (~50MB instead of ~200MB)"/>
    </target>

    <!-- =================================
          Target: package-installer-windows
         ================================= -->
    <target name="package-installer-windows" depends="package-exe-release" if="is.windows.release"
            description="Create the Windows EXE installer from the protected app image">
        <mkdir dir="${dist.dir}/installers"/>
        <exec executable="jpackage" failonerror="true">
            <arg value="--type"/><arg value="exe"/>
            <arg value="--app-image"/><arg value="${dist.dir}/${app.name}"/>
            <arg value="--dest"/><arg value="${dist.dir}/installers"/>
            <arg value="--name"/><arg value="${app.name}"/>
            <arg value="--app-version"/><arg value="${app.version}"/>
            <arg value="--vendor"/><arg value="${app.vendor}"/>
            <arg value="--win-per-user-install"/>
            <arg value="--win-upgrade-uuid"/><arg value="${windows.upgrade.uuid}"/>
            <arg value="--win-dir-chooser"/>
            <arg value="--win-menu"/>
            <arg value="--win-shortcut"/>
            <arg value="--win-shortcut-prompt"/>
            <arg value="--win-menu-group"/><arg value="${app.name}"/>
        </exec>
    </target>

    <!-- =================================
          Target: package-installer-mac
         ================================= -->
    <target name="package-installer-mac" depends="package-exe-release" if="is.mac.release"
            description="Create the macOS DMG installer from the protected app image">
        <mkdir dir="${dist.dir}/installers"/>
        <exec executable="jpackage" failonerror="true">
            <arg value="--type"/><arg value="dmg"/>
            <arg value="--app-image"/><arg value="${dist.dir}/${app.name}.app"/>
            <arg value="--dest"/><arg value="${dist.dir}/installers"/>
            <arg value="--name"/><arg value="${app.name}"/>
            <arg value="--app-version"/><arg value="${app.version}"/>
            <arg value="--vendor"/><arg value="${app.vendor}"/>
        </exec>
    </target>

    <!-- =================================
          Target: package-installer-release
         ================================= -->
    <target name="package-installer-release"
            depends="package-installer-windows,package-installer-mac"
            description="Create the platform-native production installer">
        <condition property="installer.supported">
            <or>
                <isset property="is.windows.release"/>
                <isset property="is.mac.release"/>
            </or>
        </condition>
        <fail unless="installer.supported"
              message="Production installers are currently supported on Windows and macOS only."/>
        <echo message="Installer created in: ${dist.dir}/installers"/>
    </target>

    <!-- =================================
          Target: package-license-exe
         ================================= -->
    <target name="package-license-exe" depends="jar-license,create-custom-runtime,jpackage-check"
            description="Create license.exe executable">
        <fail unless="jpackage.available"
              message="jpackage not found! Please ensure you have JDK 14+ with jpackage in your PATH."/>

        <echo message="Creating license.exe executable..."/>

        <!-- Create clean input directory for jpackage -->
        <mkdir dir="${build.dir}/jpackage-input-license"/>
        <copy file="${jar.license.file}" todir="${build.dir}/jpackage-input-license"/>

        <!-- Detect OS and set icon file accordingly -->
        <condition property="is.windows.license">
            <os family="windows"/>
        </condition>
        <condition property="is.mac.license">
            <os family="mac"/>
        </condition>
        <condition property="is.linux.license">
            <and>
                <os family="unix"/>
                <not><os family="mac"/></not>
            </and>
        </condition>

        <!-- Determine which icon file to use based on OS -->
        <condition property="icon.file.license" value="${icon.windows}">
            <isset property="is.windows.license"/>
        </condition>
        <condition property="icon.file.license" value="${icon.mac}">
            <isset property="is.mac.license"/>
        </condition>
        <condition property="icon.file.license" value="${icon.linux}">
            <isset property="is.linux.license"/>
        </condition>

        <!-- Check if icon file exists -->
        <available file="${icon.file.license}" property="icon.exists.license"/>
        <condition property="use.icon.license">
            <and>
                <isset property="icon.file.license"/>
                <isset property="icon.exists.license"/>
            </and>
        </condition>

        <!-- Display icon status -->
        <echo message="Creating license viewer executable for: ${os.name}"/>
        <condition property="icon.status.license" value="found - will be included" else="not found - using default">
            <isset property="use.icon.license"/>
        </condition>
        <echo message="Icon status: ${icon.status.license}"/>

        <!-- Execute with icon if available -->
        <exec executable="jpackage" failonerror="true" if:set="use.icon.license"
              xmlns:if="ant:if">
            <arg value="--input"/><arg value="${build.dir}/jpackage-input-license"/>
            <arg value="--name"/><arg value="license"/>
            <arg value="--main-jar"/><arg value="License-Viewer.jar"/>
            <arg value="--main-class"/><arg value="LicenseText"/>
            <arg value="--type"/><arg value="app-image"/>
            <arg value="--dest"/><arg value="${build.dir}"/>
            <arg value="--app-version"/><arg value="${app.version}"/>
            <arg value="--vendor"/><arg value="${app.vendor}"/>
            <arg value="--description"/><arg value="License Agreement Viewer"/>
            <arg value="--runtime-image"/><arg value="${custom.runtime.dir}"/>
            <arg value="--java-options"/><arg value="-Xmx256m"/>
            <arg value="--icon"/>
            <arg value="${icon.file.license}"/>
        </exec>

        <!-- Execute without icon if not available -->
        <exec executable="jpackage" failonerror="true" unless:set="use.icon.license"
              xmlns:unless="ant:unless">
            <arg value="--input"/><arg value="${build.dir}/jpackage-input-license"/>
            <arg value="--name"/><arg value="license"/>
            <arg value="--main-jar"/><arg value="License-Viewer.jar"/>
            <arg value="--main-class"/><arg value="LicenseText"/>
            <arg value="--type"/><arg value="app-image"/>
            <arg value="--dest"/><arg value="${build.dir}"/>
            <arg value="--app-version"/><arg value="${app.version}"/>
            <arg value="--vendor"/><arg value="${app.vendor}"/>
            <arg value="--description"/><arg value="License Agreement Viewer"/>
            <arg value="--runtime-image"/><arg value="${custom.runtime.dir}"/>
            <arg value="--java-options"/><arg value="-Xmx256m"/>
        </exec>

        <!-- Clean up temporary input directory -->
        <delete dir="${build.dir}/jpackage-input-license"/>

        <echo message="License viewer executable created in: ${build.dir}/license/"/>
    </target>

    <!-- =================================
          Target: build (Development)
         ================================= -->
    <target name="build" depends="package-exe"
            description="Full build: compile, JAR, and native executable (no obfuscation)">
        <echo message=""/>
        <echo message="======================================"/>
        <echo message="Development Build Complete!"/>
        <echo message="======================================"/>
        <echo message="JAR file: ${jar.file}"/>
        <echo message="Executable: ${dist.dir}/${app.name}-dev/ (optimized with custom JRE)"/>
        <echo message=""/>
        <echo message="To test JAR: java -jar ${jar.file}"/>
        <echo message=""/>
    </target>

    <!-- =================================
          Target: build-release (Production)
         ================================= -->
    <target name="build-release" depends="package-installer-release"
            description="Full release build: protected JAR, optimized runtime, app image, and native installer">
        <echo message=""/>
        <echo message="======================================"/>
        <echo message="Production Build Complete!"/>
        <echo message="======================================"/>
        <echo message="Protected JAR: ${jar.obfuscated.file}"/>
        <echo message="Executable: ${dist.dir}/${app.name}/ (optimized with custom JRE)"/>
        <echo message="Private mapping: ${proguard.mapping.file}"/>
        <echo message=""/>
        <echo message="IMPORTANT: Never distribute files from ${private.build.dir}; keep the mapping private for crash retracing."/>
        <echo message="Size reduction: ~60% smaller than standard JRE bundle"/>
        <echo message=""/>
    </target>

    <!-- =================================
          Target: build-release-with-license
         ================================= -->
    <target name="build-release-with-license" depends="package-exe-release,package-license-exe"
            description="Full release build with license.exe included">
        <echo message="Copying license executable to release directory..."/>

        <!-- Detect platform and copy appropriate executable -->
        <condition property="license.exe.name" value="license.exe" else="license">
            <os family="windows"/>
        </condition>

        <!-- Copy license executable to main application directory -->
        <copy file="${build.dir}/license/${license.exe.name}"
              tofile="${dist.dir}/${app.name}/${license.exe.name}"
              failonerror="true"/>

        <echo message=""/>
        <echo message="======================================"/>
        <echo message="Production Build Complete (with License)!"/>
        <echo message="======================================"/>
        <echo message="Protected JAR: ${jar.obfuscated.file}"/>
        <echo message="Executable: ${dist.dir}/${app.name}/ (optimized with custom JRE)"/>
        <echo message="License Viewer: ${dist.dir}/${app.name}/${license.exe.name}"/>
        <echo message="Private mapping: ${proguard.mapping.file}"/>
        <echo message=""/>
        <echo message="IMPORTANT: Never distribute files from ${private.build.dir}; keep the mapping private for crash retracing."/>
        <echo message="Size reduction: ~60% smaller than standard JRE bundle"/>
        <echo message=""/>
    </target>

    <!-- =================================
          Target: test-jar
         ================================= -->
    <target name="test-jar" depends="verify-runtime-jar" description="Test the JAR file">
        <echo message="Testing JAR file..."/>
        <java jar="${jar.file}" fork="true" failonerror="true">
            <jvmarg value="-Xmx1024m"/>
        </java>
    </target>

    <!-- =================================
          Target: help
         ================================= -->
    <target name="help" description="Display help information">
        <echo message=""/>
        <echo message="WareStat Build System"/>
        <echo message="====================="/>
        <echo message=""/>
        <echo message="Available targets:"/>
        <echo message=""/>
        <echo message="  ant build                      - Development build (JAR + executable, no obfuscation)"/>
        <echo message="  ant build-release              - Production build (protected JAR + executable)"/>
        <echo message="  ant build-release-with-license - Production build with license.exe included"/>
        <echo message="  ant jar                        - Create JAR only (no obfuscation)"/>
        <echo message="  ant obfuscate          - Create protected JAR only"/>
        <echo message="  ant package-exe        - Create native executable from JAR"/>
        <echo message="  ant package-exe-release - Create native executable from protected JAR"/>
        <echo message="  ant test-jar           - Test the JAR file"/>
        <echo message="  ant clean              - Clean build artifacts"/>
        <echo message="  ant help               - Display this help"/>
        <echo message=""/>
        <echo message="Quick start:"/>
        <echo message="  Development: ant build"/>
        <echo message="  Production:  ant build-release"/>
        <echo message=""/>
    </target>

    <target name="test" depends="compile" description="Run isolated business and data regression scenarios">
        <mkdir dir="${build.dir}/test-classes"/>
        <tempfile property="test.run.dir" destdir="${build.dir}" prefix="regression-" createfile="false"/>
        <mkdir dir="${test.run.dir}/home"/>
        <javac srcdir="tests" destdir="${build.dir}/test-classes" includeantruntime="false" release="21" encoding="UTF-8">
            <classpath><pathelement location="${build.classes.dir}"/><path refid="compile.classpath"/></classpath>
        </javac>
        <java classname="RegressionTest" fork="true" failonerror="true">
            <classpath><pathelement location="${build.dir}/test-classes"/><pathelement location="${build.classes.dir}"/><path refid="compile.classpath"/></classpath>
            <sysproperty key="java.awt.headless" value="true"/>
            <sysproperty key="user.home" value="${test.run.dir}/home"/>
            <sysproperty key="test.output" value="${test.run.dir}/evidence"/>
        </java>
    </target>
</project>
